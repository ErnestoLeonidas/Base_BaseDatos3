# Copiar este archivo a ".env" y ajustar los valores para el entorno local.
# No usar estas credenciales en un ambiente real: son solo de ejemplo para desarrollo.

# Usuario y contraseña de la aplicación dentro de Oracle (se usan tanto para crear
# el usuario de la base de datos al levantar el contenedor, como para que la API
# se conecte a él).
ORACLE_USER=app_evalai
ORACLE_PASSWORD=CambiaEstaClave123

# Cadena de conexión (host:puerto/servicio). "oracle" es el nombre del servicio
# definido en docker-compose.yml dentro de la red de Docker.
ORACLE_DSN=oracle:1521/FREEPDB1

# Entorno de ejecución: desarrollo | pruebas | produccion
APP_ENV=desarrollo
